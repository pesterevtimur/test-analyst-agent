# Copy to .env and fill in. .env is gitignored and never committed.

# LLM provider (OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-replace-me

# Oracle Database Free
ORACLE_PASSWORD=replace-me
ORACLE_APP_USER=agent_ro
ORACLE_APP_USER_PASSWORD=replace-me
# The agent connects to the reporting replica, never to FREEPDB1.
ORACLE_DSN=127.0.0.1:1521/REPPDB1

# Observability (Langfuse or Phoenix, decided on day 1 by measurement)
OBSERVABILITY_HOST=http://127.0.0.1:3000
OBSERVABILITY_PUBLIC_KEY=replace-me
OBSERVABILITY_SECRET_KEY=replace-me

# Control panel: one password for everyone, no user store. What that means and
# what production would need is written in docs/limits.md.
PANEL_PASSWORD=replace-me
PANEL_ANALYSTS=lead-analyst,analyst-1,analyst-2

# Langfuse, provisioned headlessly on the first start of langfuse-web.
LANGFUSE_INIT_ORG_ID=sap-agent
LANGFUSE_INIT_ORG_NAME=sap-agent
LANGFUSE_INIT_PROJECT_ID=analyst
LANGFUSE_INIT_PROJECT_NAME=analyst-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-me
LANGFUSE_INIT_USER_EMAIL=you@example.com
LANGFUSE_INIT_USER_NAME=You
LANGFUSE_INIT_USER_PASSWORD=replace-me
